# Application Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Settings (Separated Variables - Change in production)
POSTGRES_USER=swpm_user
POSTGRES_PASSWORD=change_me_to_strong_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=swpm_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# MQTT Broker Settings (Separated Variables)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_URL=mqtt://${MQTT_HOST}:${MQTT_PORT}
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=swpm-backend
MQTT_TOPIC_PREFIX=swpm/v1

# Security & JWT Authentication (Change JWT_SECRET in production)
JWT_SECRET=change_me_to_random_long_secret_key_minimum_32_characters
ACCESS_TOKEN_TTL=7d
REFRESH_TOKEN_TTL=30d

# Realtime Engine & Timeouts
SSE_HEARTBEAT_INTERVAL=15000
DEVICE_OFFLINE_TIMEOUT=30000
COMMAND_TIMEOUT_SECONDS=15
TELEMETRY_RETENTION_DAYS=30
