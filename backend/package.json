    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.1.0",
    "bcryptjs": "^2.4.3",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "fastify-type-provider-zod": "^2.0.0",
    "mqtt": "^5.10.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
