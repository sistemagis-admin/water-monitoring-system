{
  "name": "water-monitoring-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Smart Water Pump Monitoring System - Fastify Backend API & MQTT Ingestion Gateway",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/infrastructure/db/migrate.ts",
    "seed": "tsx src/infrastructure/db/seed.ts",
    "simulate": "tsx src/simulator/mqtt-simulator.ts",
    "generate:openapi": "tsx src/scripts/export-openapi.ts"
  },
  "keywords": [
    "fastify",
    "mqtt",
